{
  "name": "threecharts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A scientific visualisation and analysis system on three.js/WebGPU. Figure -> Axes -> Drawables over GPU-resident fields, with a shared animation clock and a self-contained colormap atlas. Charts and TSL compute read and write the same buffers.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./colormaps/*": "./public/colormaps/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:gpu": "npm run build && vitest run --project gpu",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "check": "npm run typecheck && npm run test && npm run test:gpu && npm run build",
    "test:gpu:software": "npm run build && WEBGPU_SOFTWARE=1 vitest run --project gpu",
    "dev": "vite",
    "build:examples": "vite build"
  },
  "peerDependencies": {
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "0.183.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.62.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "module": "./dist/index.js",
  "files": [
    "dist",
    "public/colormaps",
    "DIRECTION.md",
    "docs/FOUNDATIONS.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
